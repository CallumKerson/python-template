[deps.uv]
auto = true

[settings]
experimental = true
lockfile = true
{%- if project_type == 'library' %}

[tasks.build]
description = "Build the sdist and wheel into dist/"
run = ["rm -rf dist", "uv build"]
{%- endif %}

[tasks.check]
description = "Run all linter and formatter checks with hk against changed files"
run = "hk check --no-fail-fast"

[tasks.check-all]
description = "Run all linter and formatter checks with hk against all files"
run = "hk check --all --no-fail-fast"
{%- if github %}

[tasks.check-auto]
description = "Check all files on main, or only changed files on other branches"
run = '''
if [ "$(git branch --show-current)" = "main" ]; then
  mise run check-all
else
  mise run check-pr
fi
'''

[tasks.check-pr]
description = "Run all checks against files changed since main"
run = ["git fetch origin main", "hk check --from-ref origin/main --to-ref HEAD --no-fail-fast"]

[tasks.ci]
description = "Run the checks and tests CI runs"
depends = ["check-auto", "test"]
{%- endif %}

[tasks.fix]
description = "Fix all linter and formatter issues with hk against changed files"
run = "hk fix --no-fail-fast"

[tasks.fix-all]
description = "Fix all linter and formatter issues with hk against all files"
run = "hk fix --all --no-fail-fast"
{%- if github %}

[tasks.fix-pr]
description = "Fix issues in files changed since main"
run = ["git fetch origin main", "hk fix --from-ref origin/main --to-ref HEAD --no-fail-fast"]
{%- endif %}

[tasks.setup]
description = "Pin versions and install the git hooks in a new project"
run = ["git rev-parse --git-dir >/dev/null 2>&1 || git init --quiet", "mise run pin", "hk install"]

[tasks.test]
description = "Run tests with pytest"
run = "uv run pytest"

[tasks.update-template]
description = "Pull in changes from the python-template copier template"
run = ["uvx copier update --skip-answered --answers-file .copier-answers.yaml", "mise run pin"]

[tools."aqua:owenlamont/ryl"]
version = "latest"
{%- if github %}

[tools.aube]
version = "latest"
{%- endif %}

[tools.hk]
version = "latest"
{%- if github %}

[tools.jactionlint]
version = "latest"
{%- endif %}
{%- if github %}

[tools.oxfmt]
version = "latest"
depends = ["aube"]
{%- endif %}

[tools.pkl]
version = "latest"

[tools.ruff]
version = "latest"

[tools.rumdl]
version = "latest"
{%- if github %}

[tools.shellcheck]
version = "latest"
{%- endif %}

[tools.tombi]
version = "latest"

[tools.ty]
version = "latest"

[tools.typos]
version = "latest"

[tools.uv]
version = "latest"
