{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":automergeStableNonMajor", ":automergeDigest"],
  "schedule": ["every 2 weeks on saturday and sunday"],
  "prConcurrentLimit": 3,
  "copier": {
    "managerFilePatterns": ["/(^|/)\\.config/copier-answers\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep the hk.pkl package version in step with hk",
      "managerFilePatterns": ["/(^|/)hk\\.pkl$/"],
      "matchStrings": [
        "releases/download/v(?<currentValue>[^/]+)/hk@",
        "hk@(?<currentValue>[^#]+)#",
        "min_hk_version = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "jdx/hk",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["lockFileMaintenance"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["pin"],
      "automerge": true
    },
    {
      "matchFileNames": [".github/**"],
      "semanticCommitType": "ci"
    },
    {
      "matchFileNames": ["mise.toml", "hk.pkl"],
      "semanticCommitType": "build"
    },
    {
      "matchDepNames": ["hk", "jdx/hk"],
      "groupName": "hk"
    },
    {
      "matchDepNames": ["python"],
      "semanticCommitType": "fix"
    },
    {
      "matchDepNames": ["uv_build"],
      "semanticCommitType": "build"
    }
  ]
}
